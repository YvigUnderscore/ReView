{
  "name": "frontend",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-docs.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.config.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
