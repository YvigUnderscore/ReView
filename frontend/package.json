    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.9"
