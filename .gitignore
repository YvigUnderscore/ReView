node_modules/
dev_data/
storage/
.env
.claude
/.jules
*.bat
/tmp/

# Build artifacts
backend/dist/
frontend/dist/
frontend/public/docs/
*.tsbuildinfo

# Logs & couverture de tests
*.log
coverage/

# Plans (artefacts de session Claude)
plans/
/assets_for_testing

# Journaux d'avancées (logs Claude — locaux)
logs/

# Contexte Claude / agents (local uniquement)
CLAUDE.md
AGENTS.md

# Docs internes (audit, rapports — non nécessaires à l'app)
/docs/

# Références de design (bundle de handoff) — ne pas versionner
design_handoff_review_chrome/

# Playwright (10.F3)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Certificats TLS de prod (montés dans nginx) — jamais commités
nginx/certs/

# Mot de passe du relais SMTP d'Alertmanager (monté dans le conteneur) — jamais commité
monitoring/alertmanager/smtp_password
backups/

# Ce que `scripts/install.sh` rend pour CETTE instance : configuration nginx du site,
# surcouches compose, certificats Let's Encrypt, réglages de l'agent d'exploitation.
# Le script annonce en tête qu'il n'écrit aucun fichier versionné ; sans cette ligne, il
# mentait : après une installation, `git status` était sale et `scripts/update.sh` refusait
# de basculer (« des fichiers suivis sont modifiés localement »).
deploy/

# File d'ordres et journaux d'exécution de l'agent (Admin → Mises à jour). Contient le nom
# des personnes qui ont commandé une opération : rien qui doive partir dans un dépôt.
ops/
