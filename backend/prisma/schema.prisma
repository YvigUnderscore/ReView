// ReView 2.0 — Schéma PostgreSQL
// Hiérarchie pipeline : Studio > Projet > Séquence(opt) > Shot > Task > Version > MediaObject
//                                       > Asset(réutilisable) > Version > MediaObject
// Décision 8.1 : une instance = un Studio (singleton). RBAC global sur User + ProjectMembership.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SUPERVISOR
  ARTIST
  CLIENT
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum AssetType {
  CHARACTER
  PROP
  ENVIRONMENT
  VEHICLE
  FX
  OTHER
}

enum TaskType {
  MODELING
  RIGGING
  ANIMATION
  FX
  LIGHTING
  COMPOSITING
  LOOKDEV
  LAYOUT
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
  RETAKE
}

enum VersionStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum MediaKind {
  VIDEO
  IMAGE
  MODEL_3D
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum SharePermission {
  VIEW
  COMMENT
}

enum UserStatus {
  AVAILABLE
  AWAY
  DND
}

// ─────────────────────────────────────────────────────────────────────────────
// Studio (singleton) & configuration
// ─────────────────────────────────────────────────────────────────────────────

model Studio {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  discordWebhookUrl String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projects Project[]
}

// Réglages clé/valeur configurables depuis l'admin (quotas, limites upload, etc.)
model Setting {
  key   String @id
  value String
}

// ─────────────────────────────────────────────────────────────────────────────
// Utilisateurs & accès
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String? // nom complet legacy (affichage de repli)
  firstName    String?
  lastName     String?
  username     String?  @unique // pseudo affiché en priorité
  avatarKey    String? // clé objet MinIO
  role         Role     @default(ARTIST)
  status       UserStatus @default(AVAILABLE) // statut manuel (dispo/absent/ne pas déranger)
  lastSeenAt   DateTime? // dernière activité connue (présence)
  storageUsed  BigInt   @default(0)
  storageLimit BigInt?
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      ProjectMembership[]
  uploadedMedia    MediaObject[]       @relation("MediaUploader")
  authoredVersions Version[]           @relation("VersionAuthor")
  assignedTasks    Task[]              @relation("TaskAssignee")
  comments         Comment[]           @relation("CommentAuthor")
  assignedComments Comment[]           @relation("CommentAssignee")
  reactions        Reaction[]
  notifications    Notification[]
  createdShares    ShareLink[]         @relation("ShareCreator")
  auditLogs        AuditLog[]
  boardChanges     BoardChange[]
  passwordResets   PasswordReset[]
  favorites        Favorite[]
  documents        Document[]
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProjectMembership {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  role      Role? // override du rôle global au niveau projet (optionnel)
  joinedAt  DateTime @default(now())

  @@unique([userId, projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hiérarchie pipeline
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id           Int           @id @default(autoincrement())
  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId     Int
  name         String
  slug         String
  description  String?
  thumbnailKey String?
  status       ProjectStatus @default(ACTIVE)
  startFrame   Int           @default(1001)
  // Réglages projet : départements, nomenclature (override des défauts studio). JSON.
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  sequences   Sequence[]
  shots       Shot[]
  assets      Asset[]
  memberships ProjectMembership[]
  shareLinks  ShareLink[]
  notifications Notification[]
  board       Board?

  @@unique([studioId, slug])
}

model Sequence {
  id        Int    @id @default(autoincrement())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  code      String
  order     Int    @default(0)
  deletedAt DateTime?

  shots  Shot[]
  assets Asset[] @relation("AssetSequences")

  @@unique([projectId, code])
}

model Shot {
  id         Int       @id @default(autoincrement())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  sequence   Sequence? @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  sequenceId Int?
  name       String
  code       String
  startFrame Int?
  endFrame   Int?
  order      Int       @default(0)
  thumbnailKey String?
  deletedAt  DateTime?

  tasks  Task[]
  assets Asset[] @relation("AssetShots")

  // Un code de shot (ex: SH001) est unique par séquence : SH001 peut exister
  // dans SQ001 ET SQ002. Les shots « sans séquence » (sequenceId = null) sont
  // traités à part — l'unicité est vérifiée côté route (les NULL sont distincts en SQL).
  @@unique([projectId, sequenceId, code])
}

model Asset {
  id          Int       @id @default(autoincrement())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  name        String
  type        AssetType @default(OTHER)
  description String?
  thumbnailKey String?
  deletedAt   DateTime?

  tasks     Task[]
  versions  Version[]  @relation("AssetVersions")
  board     Board?
  shots     Shot[]     @relation("AssetShots")
  sequences Sequence[] @relation("AssetSequences")

  @@unique([projectId, name])
}

model Task {
  id         Int        @id @default(autoincrement())
  type       TaskType   @default(OTHER)
  status     TaskStatus @default(TODO)
  name       String
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Une Task est rattachée à un Shot OU un Asset (réutilisable)
  shot    Shot? @relation(fields: [shotId], references: [id], onDelete: Cascade)
  shotId  Int?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId Int?

  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId Int?

  versions Version[] @relation("TaskVersions")
}

// Version livrable (le cahier des charges parle d'« AssetVersion » ; généralisée :
// une Version appartient à une Task OU directement à un Asset réutilisable).
model Version {
  id        Int           @id @default(autoincrement())
  name      String        @default("V01")
  status    VersionStatus @default(DRAFT)
  published Boolean       @default(false)
  transform Json? // transformation 3D appliquée avant publication (orientation, scale)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  task    Task? @relation("TaskVersions", fields: [taskId], references: [id], onDelete: Cascade)
  taskId  Int?
  asset   Asset? @relation("AssetVersions", fields: [assetId], references: [id], onDelete: Cascade)
  assetId Int?

  author   User? @relation("VersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId Int?

  media MediaObject[]
}

model MediaObject {
  id           Int         @id @default(autoincrement())
  version      Version     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId    Int
  kind         MediaKind
  originalName String
  storageKey   String // clé objet MinIO
  mimeType     String
  size         BigInt      @default(0)
  status       MediaStatus @default(UPLOADING)
  // Draft : un média non publié n'est visible que par son uploader (review/édition
  // avant diffusion à l'équipe). Publié explicitement par l'uploader.
  published    Boolean     @default(false)
  metadata     Json        @default("{}") // frameRate, dimensions, durée, format splat, etc.
  thumbnailKey String?
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  uploader   User? @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderId Int?

  comments Comment[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Board 2D collaboratif (tldraw)
// ─────────────────────────────────────────────────────────────────────────────

// Board mood/reference (9.B) — rattaché à un Projet OU un Asset (XOR), plus à une version.
model Board {
  id        Int      @id @default(autoincrement())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int?     @unique
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId   Int?     @unique
  document  Json     @default("{}") // scène Excalidraw
  updatedAt DateTime @updatedAt

  changes BoardChange[]
}

model BoardChange {
  id        Int      @id @default(autoincrement())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   Int
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  summary   String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Review : commentaires unifiés (un seul modèle pour tous les types de média)
// ─────────────────────────────────────────────────────────────────────────────

model Comment {
  id            Int      @id @default(autoincrement())
  media         MediaObject @relation(fields: [mediaObjectId], references: [id], onDelete: Cascade)
  mediaObjectId Int
  author        User?    @relation("CommentAuthor", fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?
  guestName     String?
  content       String
  timestamp     Float? // temps vidéo (s)
  duration      Float? // durée de la plage commentée (s)
  annotation    Json? // dessin/annotation 2D
  cameraState   Json? // viewpoint 3D/splat (position, target, fov…)
  screenshotKey String? // capture annotée (MinIO)
  attachments   Json? // pièces jointes (clés MinIO)
  isResolved    Boolean  @default(false)
  isVisibleToClient Boolean @default(false)
  isEdited      Boolean  @default(false)
  createdAt     DateTime @default(now())

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  replies  Comment[] @relation("CommentReplies")

  assignee   User? @relation("CommentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId Int?

  reactions Reaction[]
}

model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int?
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int
  guestName String?
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
}

// ─────────────────────────────────────────────────────────────────────────────
// Partage client sécurisé
// ─────────────────────────────────────────────────────────────────────────────

model ShareLink {
  id          Int             @id @default(autoincrement())
  token       String          @unique
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  permission  SharePermission @default(VIEW)
  expiresAt   DateTime?
  revoked     Boolean         @default(false)
  createdBy   User?           @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  createdAt   DateTime        @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications & audit
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  type        String   @default("SYSTEM") // MENTION, REPLY, STATUS, SYSTEM…
  content     String
  referenceId Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?
  action     String
  entityType String?
  entityId   Int?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Favoris & documentation
// ─────────────────────────────────────────────────────────────────────────────

enum EntityType {
  PROJECT
  SEQUENCE
  SHOT
  ASSET
}

model Favorite {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      EntityType
  entityId  Int
  createdAt DateTime   @default(now())

  @@unique([userId, type, entityId])
  @@index([userId])
}

enum DocScope {
  GLOBAL
  PROJECT
  SEQUENCE
  SHOT
  ASSET
}

enum DocKind {
  RICH
  PDF
}

model Document {
  id          Int      @id @default(autoincrement())
  title       String
  kind        DocKind  @default(RICH)
  content     String? // HTML sanitisé (RICH)
  fileKey     String? // clé MinIO (PDF)
  scope       DocScope @default(GLOBAL)
  projectId   Int? // contrôle d'accès (NULL = documentation globale studio)
  scopeId     Int? // id de l'entité documentée (séquence/shot/asset/projet)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([scope, scopeId])
}
