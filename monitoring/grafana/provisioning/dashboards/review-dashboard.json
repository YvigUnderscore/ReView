{
  "title": "ReView — API & jobs",
  "uid": "review-base",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 7,
      "type": "table",
      "title": "Active alerts (monitoring/rules/alerts.yml)",
      "description": "Rules evaluated by Prometheus. No row = nothing is firing. Does not depend on Alertmanager: without it, alerts show up here but are routed nowhere.",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 6 },
      "targets": [
        {
          "expr": "sort_desc(ALERTS{alertstate=\"firing\"})",
          "instant": true,
          "format": "table",
          "legendFormat": "{{alertname}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "alertstate": true }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Running version",
      "description": "review_worker_info: worker version and commit. Two rows during an update, a single one afterwards.",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "options": { "textMode": "name", "colorMode": "none" },
      "targets": [{ "expr": "review_worker_info", "instant": true, "legendFormat": "{{version}} ({{commit}})" }]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / s (by status)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(review_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP latency p95 (s)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(review_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "BullMQ queues (waiting / active / failed)",
      "description": "One series per queue and state (media, storage-cleanup, webhooks, timeline-export, shotgrid, maintenance, spatial-thumb).",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "review_queue_jobs{state=~\"waiting|active|failed\"}",
          "legendFormat": "{{queue}} {{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "description": "API and worker. Only the worker is expected to use a lot (ffmpeg, Blender).",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker jobs / min (by outcome)",
      "description": "review_worker_jobs_total: what the worker actually finishes, successes and failures.",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(review_worker_jobs_total[15m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job duration p95 (s, by queue)",
      "description": "A duration that drifts while volume stays flat points to a saturated disk or an encoder that fell back to CPU.",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(review_worker_job_duration_seconds_bucket[30m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    }
  ]
}
