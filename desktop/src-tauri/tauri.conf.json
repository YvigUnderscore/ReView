{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReView",
  "version": "0.1.0",
  "identifier": "io.github.yvigunderscore.review.spike",
  "build": {
    "frontendDist": "../probe"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ReView — diagnostic du webview",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Spike de validation du webview ReView",
    "longDescription": "Mesure les capacités du webview de l'OS (WebGL, codecs, WASM) pour décider si le viewer ReView peut tourner dans une application Tauri."
  }
}
