# ReView — environment variables. Copy to `.env` and edit.
#
# DEV  : docker compose up -d
#        (docker-compose.override.yml is loaded automatically: Postgres/Redis exposed locally)
# PROD : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#        (TLS nginx in front, MinIO console not exposed, CORS restricted)
#
# How this file is used:
# - It is loaded WHOLE into the `backend` and `worker` containers (`env_file:` in
#   docker-compose.yml): every variable set here reaches the API and the worker.
# - The `environment:` block of docker-compose.yml WINS over this file. It sets the values
#   that depend on the compose network (DATABASE_URL, REDIS_URL, S3_ENDPOINT, S3_ACCESS_KEY,
#   S3_SECRET_KEY, S3_FORCE_PATH_STYLE, NODE_ENV, PORT): redefining them here has no effect
#   on the containers. They are only useful to tools run from the host (Prisma CLI, seed).
# - An EMPTY variable is not the same as an ABSENT one: `SMTP_HOST=` means "configured, with
#   an empty value". Optional settings are therefore commented out — uncomment to enable.
#
# The source of truth is backend/src/config/env.ts: it validates every value at startup and
# stops the container with the list of errors if one is invalid.
# Full reference: DOCUMENTATION/infrastructure/containers-and-configuration.md

# ═════ Instance identity ═════════════════════════════════════════════════════
# Public URL of the application, as a browser sees it. Used to build the links in emails
# (invitation, daily digest, weekly report, unsubscribe).
# ⚠ WITHOUT IT, INVITING A USER FAILS (APP_URL_MISSING) and emails are sent without links.
# APP_URL=https://review.mystudio.com

# Container time zone: timestamps of digests, weekly reports and burn-ins. Default: Europe/Paris.
# TZ=Europe/Paris

# ═════ Secrets (REQUIRED — must be changed in production) ════════════════════
# At least 32 random characters: openssl rand -hex 32
# In production, the backend REFUSES to start with a short value or a "change_me" placeholder.
JWT_SECRET=change_me_with_a_long_random_secret_min_32_chars

# Encrypts the secrets stored in the database: SMTP password, webhook secrets, each
# account's TOTP secret. If unset, it is derived from JWT_SECRET — which works, but then
# rotating JWT_SECRET makes all those secrets unreadable. Set it explicitly in production.
# ⚠ Changing it later makes already-encrypted secrets unreadable.
# APP_ENCRYPTION_KEY=openssl_rand_hex_32

# Token lifetimes (ms/zeit format: 15m, 12h, 7d…). Defaults: 7d / 30d.
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d

# ─── Self-registration (POST /api/auth/register) ─────────────────────────────
# false (default): accounts are created from the admin screen or through SSO.
# true lets anyone who can reach the instance create an account — including one under a
# colleague's email before their first SSO login, which OIDC would then link to that
# account. Only enable on a closed network.
ALLOW_SELF_REGISTRATION=false

# ═════ Host ports (dev only — ignored by docker-compose.prod.yml) ════════════
PORT=3429              # frontend: HOST port → container :80. Not the backend port, which
                       # always listens on 3000 inside its container.
BPORT=3430             # backend: HOST port → container :3000
# BPORT_BIND=127.0.0.1   # 0.0.0.0 exposes the API on the network — then set TRUST_PROXY=0
# DEV_BIND=127.0.0.1     # 0.0.0.0 to reach Postgres/Redis from another machine
# POSTGRES_PORT=5432     # host port for Postgres (dev override)
# REDIS_PORT=6379        # host port for Redis (dev override)

# ═════ PostgreSQL ════════════════════════════════════════════════════════════
POSTGRES_USER=review
# PROD: use a strong password (openssl rand -hex 32)
POSTGRES_PASSWORD=review_dev
POSTGRES_DB=review
# docker-compose builds DATABASE_URL from the three lines above. This value is only read
# by tools run from the host (prisma migrate, seed):
# DATABASE_URL=postgresql://review:review_dev@localhost:5432/review?schema=public

# ─── Connection pool and query timeout ───────────────────────────────────────
# Two processes connect (backend + worker) and PostgreSQL allows 100 connections. Keep
# DB_POOL × 2 (+ psql, backups, migrations) below that. Without an explicit bound, Prisma
# sizes its pool from the CPU count, which exhausts Postgres on large hosts ("sorry, too
# many clients already").
# DB_POOL=10               # connections per process (backend and worker)
# DB_POOL_TIMEOUT=20       # seconds to wait for a free connection before failing
# Maximum duration of ONE query, in milliseconds, so a runaway query cannot hold its
# connection forever. Applied to the application's connection only — not to the Postgres
# role, where it would also cut the migrations run at startup.
# DB_STATEMENT_TIMEOUT_MS=60000

# ═════ MinIO (S3-compatible object storage) ══════════════════════════════════
# PROD: change these credentials — the backend refuses to start in production with
# minioadmin/minioadmin. The backend's S3 keys are derived from them by docker-compose.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000        # dev only — in production MinIO publishes NO host port
MINIO_CONSOLE_PORT=9001    # dev only — in production, reach the console over SSH tunnel/VPN
# MINIO_BIND=127.0.0.1     # 0.0.0.0 to deliberately expose the API/console on the network
S3_BUCKET=review

# Endpoint the BROWSER uses for presigned URLs (the internal `minio:9000` is unreachable
# from outside).
# DEV  : http://localhost:9000
# PROD : the public URL of the TLS proxy (e.g. https://review.mystudio.com) — nginx routes
#        /<bucket>/ to MinIO and keeps the signed Host header (see nginx/nginx.conf)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Region used in the S3 signature (default us-east-1; MinIO ignores it).
# S3_REGION=us-east-1

# ═════ Redis (BullMQ queues) ═════════════════════════════════════════════════
# Set by docker-compose (redis://redis:6379). Only set it for an external Redis or for a
# tool run from the host.
# REDIS_URL=redis://localhost:6379

# ═════ CORS ══════════════════════════════════════════════════════════════════
# DEV  : * (permissive)
# PROD : the exact frontend URL (e.g. https://review.mystudio.com) — the backend refuses
#        to start with '*' in production.
CORS_ORIGIN=*

# ═════ Trusted proxies (X-Forwarded-For) ═════════════════════════════════════
# Number of proxies between the client and the API. It decides whether the client address
# is read from `X-Forwarded-For` (a header the CALLER controls) or from the socket. That
# address keys every rate limiter (login, 2FA, share unlock) and is written to the audit log.
#   1 (docker-compose default): exactly one proxy sits in front of the API (the frontend
#     container, or the TLS nginx in production) and the backend port is bound to
#     loopback, so nobody can bypass it.
#   0: the API is reachable directly (BPORT_BIND=0.0.0.0, or run outside docker), or an
#     upstream proxy does not rewrite the header. The socket address is then used: wrong
#     behind a proxy, but impossible to forge.
# TRUST_PROXY=1

# ═════ Logging (pino) ════════════════════════════════════════════════════════
# fatal|error|warn|info|debug|trace|silent.
# Default: silent in test, info in production, debug in development.
# LOG_LEVEL=info

# ═════ Outgoing email (invitations, digest, weekly report) ═══════════════════
# Without SMTP_HOST NO email is sent (invitations become links to copy by hand).
# SMTP can also be configured from the admin screen; the password is then stored encrypted
# with APP_ENCRYPTION_KEY.
# SMTP_HOST=smtp.mystudio.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465)
# SMTP_USER=review@mystudio.com
# SMTP_PASS=
# SMTP_FROM=ReView <no-reply@review.local>
# DIGEST_HOUR=7              # local hour (0-23) the daily digest is sent

# ═════ Browser push notifications (Web Push / VAPID) ═════════════════════════
# Without these keys, a key pair is generated and stored in the database on first start —
# fine for development. In production, set them explicitly so existing subscriptions
# survive a database reset.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@mystudio.com

# ═════ Metrics & monitoring (`monitoring` compose profile) ═══════════════════
# Token required by GET /metrics. Unset: the endpoint is only reachable from the internal
# network.
# METRICS_TOKEN=
# Grafana admin password — required: the default admin/admin is a real admin account.
# Grafana listens on loopback only; reach it remotely over SSH tunnel/VPN.
GRAFANA_ADMIN_PASSWORD=change_me_openssl_rand_hex_24
GRAFANA_PORT=3431
GRAFANA_BIND=127.0.0.1

# ═════ Third-party image versions (never `latest`) ═══════════════════════════
# Pinned in docker-compose.yml so two installs made on different dates run the same
# software. Override here only to upgrade on purpose.
# MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
# PROMETHEUS_VERSION=v3.5.0
# GRAFANA_VERSION=11.6.1

# ═════ Container memory limits ═══════════════════════════════════════════════
# Docker `mem_limit`. The worker is the one that needs headroom: two parallel HLS
# transcodes and, with INSTALL_USD_TOOLS=1, a headless Blender.
# BACKEND_MEM_LIMIT=2g
# WORKER_MEM_LIMIT=8g
# POSTGRES_MEM_LIMIT=2g
# POSTGRES_SHM_SIZE=256mb

# ═════ Backend container health check ════════════════════════════════════════
# Route polled by the Docker health check. Keep the default `/health` (liveness: answers
# while the process runs, no I/O): a Postgres outage should not also mark the backend
# unhealthy. `/health/ready` (checks database, Redis and MinIO, 503 when one is down) is
# meant for an external load balancer or monitoring, not for this check.
# HEALTH_PATH=/health

# ═════ Antivirus (`antivirus` compose profile) ═══════════════════════════════
# ClamAV scan of uploaded files. Unset = disabled. With the compose profile:
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ═════ Media processing (worker) ═════════════════════════════════════════════
# Video encoder: libx264 (default) or h264_nvenc when an NVIDIA GPU is passed to the
# container. The worker falls back to libx264 if NVENC is unavailable.
# VIDEO_ENCODER=libx264
# Maximum run time of an external 3D converter, in ms (default 15 min).
# MODEL_CONVERT_TIMEOUT_MS=900000
# Limits applied when extracting 3D archives (protection against zip bombs).
# ARCHIVE_MAX_ENTRIES=20000
# ARCHIVE_MAX_UNCOMPRESSED_BYTES=8589934592
# ARCHIVE_MAX_COMPRESSION_RATIO=200

# ═════ USD tooling (worker image, build time) ════════════════════════════════
# Installs Blender + usd-core in the worker image: 1.6 GB → 3.6 GB. Leave empty for a
# lighter image; USD then falls back to guc/assimp (experimental support).
INSTALL_USD_TOOLS=1
# Native USD→glTF converter command (e.g. `guc`, installed with --build-arg GUC_URL).
# USD_GLTF_CONVERTER=
# Paths of the tools installed by INSTALL_USD_TOOLS — only change them for a custom image.
# USD_BLENDER_BIN=/opt/blender/blender
# USD_PYTHON_BIN=/opt/usdenv/bin/python3
# Limits when baking USD variants into the GLB (number of variants, total vertices).
# USD_MAX_BAKED_VARIANTS=512
# USD_VARIANT_VERTEX_BUDGET=8000000

# ═════ ShotGrid ══════════════════════════════════════════════════════════════
# Comma-separated hosts allowed without public HTTPS — meant for the local ShotGrid
# simulator used in development. A real ShotGrid site NEVER needs it.
# SHOTGRID_INSECURE_HOSTS=host.docker.internal:8890

# ═════ Database initialisation ═══════════════════════════════════════════════
# The backend container runs `prisma migrate deploy` at startup and STOPS if a migration
# fails — it never realigns the database on its own.
# PRISMA_DB_PUSH=1 runs `prisma db push` instead (schema pushed without versioned
# migrations): only for initialising an EMPTY development database; refused when
# NODE_ENV=production.
# PRISMA_DB_PUSH=1

# ═════ Production only ═══════════════════════════════════════════════════════
# Real domain, substituted for YOUR_DOMAIN in nginx/nginx.conf.
# SITE_DOMAIN=review.mystudio.com

# ═════ Updates & backups from the admin screen (Admin → Updates) ═════════════
# Repository whose published releases are offered — and whose release notes are shown.
# A studio running its own fork points this at its fork.
# RELEASE_REPO=YvigUnderscore/ReView
# false for an instance without outbound access: the screen stays useful (running
# version, backups, exact commands) but stops querying GitHub, and says so.
# RELEASE_CHECK_ENABLED=true
# Optional GitHub token: without it the API allows 60 requests per hour per IP address.
# Required for a private repository.
# RELEASE_GITHUB_TOKEN=
# The four directories below are set by the scripts together with the matching volume
# mounts — do not set them by hand.
# Backup directory as seen FROM the backend container (set by scripts/install.sh). If
# unset, the screen says it cannot see the backups rather than claiming there are none.
# BACKUPS_DIR=/backups
# Ops agent queue, as seen from the backend container (set by `scripts/ops-agent.sh
# install`). Two SEPARATE directories, and that separation is the security barrier: the
# backend writes orders and only reads state; the agent does the opposite. If unset, the
# screen shows the commands to run instead of buttons.
# OPS_QUEUE_DIR=/ops/queue
# OPS_STATE_DIR=/ops/state
# Silence (seconds) after which the agent is considered dead — a running operation then
# shows "unknown outcome" instead of spinning forever.
# OPS_AGENT_STALE_SEC=90
# Lifetime (seconds) of an order the agent has not picked up: an update that starts an
# hour after the click would be a surprise.
# OPS_ORDER_TTL_SEC=900

# ═════ Ops agent — read by the scripts and by compose, not by the backend ════
# Set by scripts/install.sh; listed here for reference.
#   REVIEW_ROOT             absolute path of the repository on this machine; the agent
#                           mounts it at the SAME path (scripts/backup.sh passes its pwd
#                           to `docker run`)
#   COMPOSE_PROJECT_NAME    container name prefix
#   REVIEW_IMAGE_PREFIX     registry of the published images (registry mode)
#   REVIEW_IMAGE_TAG        running version tag — never `latest` in production
#   REVIEW_OPS_IMAGE        agent image (e.g. ghcr.io/…/review-ops:v2.4.0)
#   OPS_POLL_SEC            how often the agent polls its queue, in seconds (default 2)
#   OPS_MAX_RUNTIME         maximum duration of one operation, in seconds (default 3600)
