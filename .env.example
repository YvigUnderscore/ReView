# ReView 2.0 — variables d'environnement (copier en .env)
#
# DEV  : docker compose up -d
#        (docker-compose.override.yml auto-chargé → Postgres/Redis exposés localement)
# PROD : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#        (nginx TLS en frontal, console MinIO non exposée, CORS restreint)

# ─── Secret JWT (OBLIGATOIRE — changer absolument en prod) ───────────────────
JWT_SECRET=change_me_with_a_long_random_secret_min_32_chars

# ─── Ports exposés (dev uniquement — ignorés par docker-compose.prod.yml) ────
PORT=3429              # frontend (host → :80 conteneur)
BPORT=3430            # backend  (host → :3000 conteneur)

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=review
# PROD : utiliser un mot de passe fort (openssl rand -hex 32)
POSTGRES_PASSWORD=review_dev
POSTGRES_DB=review

# ─── MinIO (stockage objet S3-compatible) ────────────────────────────────────
# PROD : changer les identifiants (ne pas laisser minioadmin/minioadmin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001    # ignoré par docker-compose.prod.yml (console non exposée)
S3_BUCKET=review

# Endpoint public vu par le navigateur pour les URLs présignées
# DEV  : http://localhost:9000
# PROD : URL publique de MinIO OU endpoint d'un CDN/S3 (ex. https://s3.mystudio.com)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ─── CORS ────────────────────────────────────────────────────────────────────
# DEV  : * (permissif)
# PROD : URL exacte du frontend (ex. https://review.mystudio.com)
CORS_ORIGIN=*

# ─── Prod uniquement ─────────────────────────────────────────────────────────
# Domaine réel utilisé dans nginx/nginx.conf (remplacer YOUR_DOMAIN)
# SITE_DOMAIN=review.mystudio.com
