# ReView 2.0 — variables d'environnement (copier en .env)
#
# DEV  : docker compose up -d
#        (docker-compose.override.yml auto-chargé → Postgres/Redis exposés localement)
# PROD : docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#        (nginx TLS en frontal, console MinIO non exposée, CORS restreint)
#
# ⚠ Ce fichier est chargé EN ENTIER dans les conteneurs `backend` et `worker`
#   (`env_file:` dans docker-compose.yml). Toute variable posée ici atteint donc l'API et
#   le worker — c'est ce qui rend les emails, les invitations et le Web Push configurables.
#
# ⚠ Précédence : les valeurs du bloc `environment:` de docker-compose.yml PRIMENT sur ce
#   fichier. Ce sont celles de la topologie réseau du compose (DATABASE_URL, REDIS_URL,
#   S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_FORCE_PATH_STYLE, NODE_ENV, PORT) :
#   les redéfinir ici n'a aucun effet sur les conteneurs. En revanche un DATABASE_URL
#   pointant vers localhost reste utile au CLI Prisma lancé depuis l'hôte.
#
# ⚠ Une variable LAISSÉE VIDE n'est pas la même chose qu'une variable ABSENTE : le backend
#   distingue « non configuré » (absente) de « chaîne vide ». Les options ci-dessous sont
#   donc commentées plutôt que vidées — les décommenter pour les activer.
#
# Le schéma qui fait foi est backend/src/config/env.ts (validation Zod au démarrage : une
# valeur invalide arrête le conteneur avec la liste des erreurs).

# ═════ Identité de l'instance ════════════════════════════════════════════════
# URL publique de l'application, telle que la voit un navigateur. Sert à fabriquer les
# liens des emails : invitation, digest quotidien, rapport hebdomadaire, désabonnement.
# ⚠ SANS ELLE, INVITER UN COLLABORATEUR ÉCHOUE (erreur APP_URL_MISSING) et les emails
#   partent sans lien.
# APP_URL=https://review.mystudio.com

# Fuseau horaire des conteneurs : horodatage des digests, des rapports hebdomadaires et
# des burn-ins gravés dans les proxies. Défaut : Europe/Paris.
# TZ=Europe/Paris

# ═════ Secrets (OBLIGATOIRE — changer absolument en prod) ════════════════════
# ≥ 32 caractères aléatoires : openssl rand -hex 32
# En production, le backend REFUSE de démarrer avec une valeur courte ou « change_me ».
JWT_SECRET=change_me_with_a_long_random_secret_min_32_chars

# Chiffre les secrets stockés en base : mot de passe SMTP, secrets de webhooks, secret
# TOTP de chaque compte. Absente, elle est dérivée de JWT_SECRET (SHA-256) — suffisant,
# mais alors faire tourner JWT_SECRET rend tous ces secrets illisibles.
# ⚠ La changer après coup rend illisibles les secrets déjà chiffrés.
# APP_ENCRYPTION_KEY=openssl_rand_hex_32

# Durée de vie des jetons (formats ms/zeit : 15m, 12h, 7d…). Défauts : 7d / 30d.
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d

# ─── Inscription libre (POST /api/auth/register) ─────────────────────────────
# false (défaut) : les comptes se créent depuis l'administration ou par SSO.
# Passer à true ouvre l'inscription à quiconque atteint l'instance — et permet de
# réserver l'email d'un collaborateur avant sa première connexion SSO, que le
# rapprochement OIDC associerait ensuite à ce compte. À n'activer qu'en réseau fermé.
ALLOW_SELF_REGISTRATION=false

# ═════ Ports exposés (dev uniquement — ignorés par docker-compose.prod.yml) ═══
PORT=3429              # frontend : port HÔTE → :80 du conteneur (PAS le port du backend,
                       # qui écoute toujours sur 3000 à l'intérieur de son conteneur)
BPORT=3430             # backend  : port HÔTE → :3000 du conteneur
# DEV_BIND=127.0.0.1     # 0.0.0.0 pour joindre Postgres/Redis depuis une autre machine
# POSTGRES_PORT=5432     # port hôte de Postgres (override de développement)
# REDIS_PORT=6379        # port hôte de Redis (override de développement)

# ═════ PostgreSQL ════════════════════════════════════════════════════════════
POSTGRES_USER=review
# PROD : utiliser un mot de passe fort (openssl rand -hex 32)
POSTGRES_PASSWORD=review_dev
POSTGRES_DB=review
# DATABASE_URL est fabriquée par docker-compose à partir des trois lignes ci-dessus.
# La valeur posée ici ne sert qu'aux outils lancés depuis l'hôte (prisma migrate, seed) :
# DATABASE_URL=postgresql://review:review_dev@localhost:5432/review?schema=public

# ═════ MinIO (stockage objet S3-compatible) ══════════════════════════════════
# PROD : changer les identifiants (ne pas laisser minioadmin/minioadmin — le backend
# refuse de démarrer en production avec ce couple).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000        # dev uniquement — en prod, MinIO n'expose AUCUN port hôte
MINIO_CONSOLE_PORT=9001    # idem (console accessible par tunnel ssh/VPN uniquement)
# MINIO_BIND=127.0.0.1     # 0.0.0.0 pour exposer sciemment l'API/la console sur le réseau
S3_BUCKET=review

# Endpoint public vu par le navigateur pour les URLs présignées
# DEV  : http://localhost:9000
# PROD : l'URL du proxy TLS (ex. https://review.mystudio.com) — nginx route
#        /<bucket>/ vers MinIO en préservant le Host signé (cf. nginx/nginx.conf)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Région S3 annoncée dans la signature (défaut us-east-1 ; MinIO l'ignore).
# S3_REGION=us-east-1
# S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY et S3_FORCE_PATH_STYLE sont posés par
# docker-compose (adresse interne du service minio + identifiants MINIO_ROOT_*).

# ═════ Redis (files BullMQ) ══════════════════════════════════════════════════
# Posé par docker-compose (redis://redis:6379). À renseigner seulement pour un Redis
# externe ou pour un outil lancé depuis l'hôte.
# REDIS_URL=redis://localhost:6379

# ═════ CORS ══════════════════════════════════════════════════════════════════
# DEV  : * (permissif)
# PROD : URL exacte du frontend (ex. https://review.mystudio.com) — le backend refuse
#        de démarrer avec '*' en production.
CORS_ORIGIN=*

# ═════ Journalisation (pino) ═════════════════════════════════════════════════
# Niveau explicite : fatal|error|warn|info|debug|trace|silent.
# Si absent : silent en test, info en production, debug en développement.
# LOG_LEVEL=info

# ═════ Email sortant (invitations, digest, rapport hebdomadaire) ═════════════
# Sans SMTP_HOST, AUCUN email n'est envoyé (les invitations restent des liens à copier).
# Le mot de passe peut aussi être saisi dans l'administration : il est alors chiffré en
# base avec APP_ENCRYPTION_KEY.
# SMTP_HOST=smtp.mystudio.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true pour du TLS implicite (port 465)
# SMTP_USER=review@mystudio.com
# SMTP_PASS=
# SMTP_FROM=ReView <no-reply@review.local>
# DIGEST_HOUR=7              # heure locale (0-23) d'envoi du digest quotidien

# ═════ Notifications push navigateur (Web Push / VAPID) ══════════════════════
# Sans ces clés, une paire est générée et persistée en base au premier démarrage — ce qui
# convient en développement. En production, les poser explicitement évite que les
# abonnements existants deviennent invalides si la base est réinitialisée.
# Génération : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@mystudio.com

# ═════ Métriques & monitoring (profil « monitoring ») ════════════════════════
# Jeton exigé par GET /metrics. Vide/absent = endpoint réservé au réseau interne.
# METRICS_TOKEN=
# Grafana administre un tableau de bord sur toute l'instance : mot de passe admin
# explicite requis (le couple admin/admin par défaut est un vrai compte admin), et
# écoute sur la boucle locale — accès distant par tunnel ssh/VPN.
GRAFANA_ADMIN_PASSWORD=change_me_openssl_rand_hex_24
GRAFANA_PORT=3431
GRAFANA_BIND=127.0.0.1

# ═════ Versions des images tierces (jamais `latest`) ═════════════════════════
# Épinglées dans docker-compose.yml ; surcharger ici pour monter de version en connaissance
# de cause. Deux installations faites à deux dates doivent exécuter le même logiciel.
# MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
# PROMETHEUS_VERSION=v3.5.0
# GRAFANA_VERSION=11.6.1

# ═════ Limites de ressources des conteneurs ══════════════════════════════════
# Bornes mémoire (docker `mem_limit`). Le worker est le seul qui doive être généreux :
# transcodage HLS ×2 en parallèle et, avec INSTALL_USD_TOOLS=1, un Blender headless.
# BACKEND_MEM_LIMIT=2g
# WORKER_MEM_LIMIT=8g
# POSTGRES_MEM_LIMIT=2g
# POSTGRES_SHM_SIZE=256mb

# ═════ Sonde de santé du conteneur backend ═══════════════════════════════════
# Route interrogée par le healthcheck docker. `/health` est une sonde de VIVACITÉ : elle
# répond « ok » sans toucher Postgres, Redis ni MinIO. Poser /health/ready le jour où
# l'API expose une sonde de disponibilité réelle (cf. infrastructure/monitoring.md).
# HEALTH_PATH=/health

# ═════ Antivirus (profil « antivirus ») ══════════════════════════════════════
# Scan ClamAV des fichiers déposés. Absent = désactivé. Avec le profil compose :
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ═════ Traitement des médias (worker) ════════════════════════════════════════
# Encodeur vidéo : libx264 (défaut) ou h264_nvenc si un GPU NVIDIA est exposé au
# conteneur. Le worker retombe automatiquement sur libx264 si NVENC est indisponible.
# VIDEO_ENCODER=libx264
# Délai maximal d'un convertisseur 3D externe (ms) — 15 min par défaut.
# MODEL_CONVERT_TIMEOUT_MS=900000
# Bornes d'extraction des archives 3D (traversée de chemin, bombes de décompression).
# ARCHIVE_MAX_ENTRIES=20000
# ARCHIVE_MAX_UNCOMPRESSED_BYTES=8589934592
# ARCHIVE_MAX_COMPRESSION_RATIO=200

# ═════ Outillage USD (image du worker) ═══════════════════════════════════════
# Blender + usd-core dans l'image du worker : 1,6 Go → 3,6 Go. Mettre à vide pour une
# image légère (l'USD retombe alors sur guc/assimp, support expérimental).
INSTALL_USD_TOOLS=1
# Convertisseur USD→glTF natif (ex. « guc », installé via --build-arg GUC_URL).
# USD_GLTF_CONVERTER=
# Chemins de l'outillage posé par INSTALL_USD_TOOLS.
# USD_BLENDER_BIN=/opt/blender/blender
# USD_PYTHON_BIN=/opt/usdenv/bin/python3
# Bornes de cuisson des variantes USD dans le GLB.
# USD_MAX_BAKED_VARIANTS=512
# USD_VARIANT_VERTEX_BUDGET=8000000

# ═════ ShotGrid (Phase 48) ═══════════════════════════════════════════════════
# Hôtes tolérés hors HTTPS public (liste séparée par des virgules) — destiné au
# simulateur de développement. Un site ShotGrid réel n'en a JAMAIS besoin.
# SHOTGRID_INSECURE_HOSTS=host.docker.internal:8890

# ═════ Base de données : initialisation ══════════════════════════════════════
# Le conteneur backend joue `prisma migrate deploy` au démarrage et S'ARRÊTE si les
# migrations échouent — il ne réaligne JAMAIS la base tout seul.
# PRISMA_DB_PUSH=1 force à la place un `prisma db push` (schéma poussé sans migration
# versionnée) : réservé à l'initialisation d'une base VIDE en développement, refusé quand
# NODE_ENV=production.
# PRISMA_DB_PUSH=1

# ═════ Prod uniquement ═══════════════════════════════════════════════════════
# Domaine réel utilisé dans nginx/nginx.conf (remplacer YOUR_DOMAIN)
# SITE_DOMAIN=review.mystudio.com
